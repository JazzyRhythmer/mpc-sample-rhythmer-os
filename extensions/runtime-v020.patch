+                roll_slice = here ? s->slice : last_slice;
+                roll_pitch = here ? s->pitch : last_pitch;
+            }
+            roll_now = (uint8_t)request;
+            roll_wait = 0;
+            roll_count = 0;
+            roll_elapsed = 0;
+            roll_gain = roll_tone = FULL;
+        }
+    }
+    stretch_all = roll_now && rolls[roll_now - 1U].kind == STRETCH_ALL;
+    if (roll_now && !stretch_all) {
