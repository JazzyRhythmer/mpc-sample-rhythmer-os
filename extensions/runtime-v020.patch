+// SPDX-License-Identifier: GPL-3.0-only
+#include "rhythmer/engine/break_manipulator.h"
+#include "rhythmer/model/acid_gen.h"
+#include "rhythmer/shell/fm1_gen_bridge.h"
+#include <algorithm>
+#include <cassert>
+#include <cmath>
+#include <cstdio>
