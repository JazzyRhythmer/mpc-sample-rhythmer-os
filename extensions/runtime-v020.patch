+#!/usr/bin/env python3
+# SPDX-License-Identifier: AGPL-3.0-only
+# Audio fixtures generated by this program are CC0-1.0.
+from pathlib import Path
+import math,random,wave,struct,subprocess,json,hashlib
+import os,shutil,argparse
+parser=argparse.ArgumentParser(description="Make original CC0 Break QA loops in an explicitly selected output directory")
+parser.add_argument("output",type=Path)
+parser.add_argument("--ffmpeg",default=os.environ.get("FFMPEG") or shutil.which("ffmpeg"))
+args=parser.parse_args()
+if not args.ffmpeg:parser.error("Pass --ffmpeg with an existing FFmpeg binary")
+q=args.output.resolve()
+helper=Path.home()/".local/share/ssd-development/bin/ssd-qa-output"
+if helper.is_file():subprocess.run([str(helper),str(q)],check=True)
+else:q.mkdir(parents=True,exist_ok=True)
+rng=random.Random(303)
+manifest=[]
+for bars in range(1,5):
+ n=bars*2*44100;a=[]
+ for i in range(n):
+  t=i/44100;beat=t%.5;back=t%1
+  kick=.52*math.exp(-beat*35)*math.sin(2*math.pi*(58*beat+45*beat*math.exp(-beat*30)))
+  sn=.30*math.exp(-((back-.5)%1)*40)*(rng.random()*2-1)
+  hat=.07*math.exp(-(t%.25)*120)*(rng.random()*2-1)
+  a.append(int(max(-.95,min(.95,kick+sn+hat)) *32767))
+ for variant in ['aligned','offset','padding','trim']:
+  if variant=='aligned':v=a
+  elif variant=='offset':v=[0]*4410+a[:-4410]
+  elif variant=='padding':v=a+[0]*11025
+  else:v=a[4410:]
+  p=q/f'{bars}bar-{variant}.wav'
+  with wave.open(str(p),'wb') as f:f.setnchannels(1);f.setsampwidth(2);f.setframerate(44100);f.writeframes(struct.pack('<'+'h'*len(v),*v))
+  manifest.append(dict(file=p.name,bars=bars,variant=variant,frames=len(v),sha256=hashlib.sha256(p.read_bytes()).hexdigest()))
+ff=args.ffmpeg
+for suffix,codec in [('flac','flac'),('ogg','libvorbis'),('mp3','libmp3lame'),('aiff','pcm_s16be')]:
+ subprocess.run([ff,'-v','error','-y','-i',str(q/'2bar-aligned.wav'),'-c:a',codec,str(q/('2bar-aligned.'+suffix))],check=True)
+(q/'MANIFEST.json').write_text(json.dumps(dict(license='CC0-1.0',origin='Original deterministic synthetic drum fixtures; no third-party break recordings.',sources=manifest),indent=2)+'\n')
+print(len(manifest),'original loops and four extra audio formats')
