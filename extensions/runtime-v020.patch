+JUNGLE_AUDIO_CODE unsigned rnd(void)
+{
+    uint32_t x = rng;
+    x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+    rng = x;
+    return x >> 16; /* 0..65535 */
+}
+/* 0..n-1 without division. */
+JUNGLE_AUDIO_CODE unsigned rnd_below(unsigned n) { return (rnd() * n) >> 16; }
