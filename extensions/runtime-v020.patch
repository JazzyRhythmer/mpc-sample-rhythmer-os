+        else {
+            tick_late = 0;
+            trigger(shot & 15U, 0, FULL, 0, FULL, 0);
+            last_slice = (uint8_t)(shot & 15U);
+        }
+    }
+    if(six_seq_release){
+        if(!ctl_roll&&!six_seq_roll){roll_now=0;view_roll=-1;for(unsigned k=0;k<2;k++)voices[k].releasing=1;}
