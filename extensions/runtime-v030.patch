+int fit(int note, const Gen8Voice& v) {
+    int lo=std::min<unsigned>(v.low,127), hi=std::clamp<int>(v.high,lo,127);
+    while (note<lo) note+=12;
+    while (note>hi && note-12>=lo) note-=12;
+    return std::clamp(note,lo,hi);
