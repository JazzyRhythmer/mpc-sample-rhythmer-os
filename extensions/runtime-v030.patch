+inline bool under(const std::filesystem::path& path, const std::filesystem::path& root) {
+    auto p = path.lexically_normal(), r = root.lexically_normal();
+    auto a = p.begin(), b = r.begin();
+    for (; b != r.end(); ++a, ++b) if (a == p.end() || *a != *b) return false;
+    return true;
