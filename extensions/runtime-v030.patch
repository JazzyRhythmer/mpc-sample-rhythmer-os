+   float al[128]{},ar[128]{},bl[128]{},br[128]{};a.render(al,ar,128,44100);b.render(bl,br,128,44100);
+   for(unsigned n=0;n<128;n++)check(std::fabs(al[n]-bl[n])<.00001f,"recorded FX velocity leaves source level unchanged");
+  }
+ }
